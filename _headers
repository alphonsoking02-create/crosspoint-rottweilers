# Netlify cache + security headers — Crosspoint Rottweilers
#
# WHY THIS FILE EXISTS
# By default Netlify serves everything as "max-age=0, must-revalidate", so a
# returning visitor re-checks every single photo on every page view. These rules
# let the browser reuse what it already downloaded, which is most of the speed
# gain for anyone who visits more than one page.
#
# IMPORTANT — HOW TO CHANGE A PHOTO
# Photos are cached for a year BY FILENAME. If you edit or replace a photo, save
# it under a NEW filename (adidas-card.webp -> adidas-card-v2.webp) and update the
# page to point at it. If you re-upload over the same filename, people who have
# already visited may keep seeing the OLD picture for a long time.
#
# If you edit style.css, bump the ?v= number in the pages (currently ?v=8).

# Photos — safe to cache hard, they are versioned by filename.
/images/*
  Cache-Control: public, max-age=31536000

# Digital business card (/card/) assets. Listed individually rather than
# /card/* so the page's own HTML keeps revalidating.
/card/card-hero.webp
  Cache-Control: public, max-age=31536000
/card/crest.png
  Cache-Control: public, max-age=31536000
/card/crosspoint_available_puppies_qr.png
  Cache-Control: public, max-age=31536000

# Self-hosted fonts — never change, safe to cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000

# Favicons / app icons at the site root.
/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon-16x16.png
  Cache-Control: public, max-age=2592000
/favicon-32x32.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/android-chrome-192x192.png
  Cache-Control: public, max-age=2592000
/android-chrome-512x512.png
  Cache-Control: public, max-age=2592000

# CSS/JS are cache-busted with ?v=N in the pages. 30 days, so a forgotten bump
# corrects itself rather than sticking for a year.
/style.css
  Cache-Control: public, max-age=2592000
/script.js
  Cache-Control: public, max-age=2592000
/gallery.js
  Cache-Control: public, max-age=2592000

# Security headers for everything.
#
# NOTE: do NOT put Cache-Control in this /* block. Netlify lets the catch-all
# override the specific rules above, which silently kills all image caching.
# Pages get Netlify's default (max-age=0, must-revalidate) anyway, which is
# exactly what we want for HTML.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://snapwidget.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src 'self' https://snapwidget.com; connect-src 'self' https://snapwidget.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests

# ---------------------------------------------------------------------------
# Content-Security-Policy notes — READ BEFORE ADDING ANYTHING TO THE SITE
#
#   script-src 'self' https://snapwidget.com
#     There are ZERO inline <script> blocks on the site (the gallery lightbox
#     lives in gallery.js precisely so this can stay strict). If you paste an
#     inline <script> into a page it WILL be blocked and silently do nothing.
#     Put new JS in a .js file instead.
#
#   style-src 'self' 'unsafe-inline'
#     Required: the pages use 13 <style> blocks and ~225 style="..." attributes.
#     Removing 'unsafe-inline' would need all of those rewritten.
#
#   img-src 'self' data:
#     'data:' is needed for the blurred hero placeholders (LQIP) and the
#     gallery magnifier icon, which are embedded as data URIs.
#
#   snapwidget.com is the Instagram feed on the homepage (script + iframe).
#     If that widget is ever removed, drop it from script-src/frame-src/connect-src.
#
#   A new third-party embed (YouTube, a map, a booking widget) will be BLOCKED
#   until its origin is added to the matching directive.
#
# ---------------------------------------------------------------------------
# HOW TO ALLOW A NEW EMBED
#
# 1. Look at the code the company gives you and match it to a directive:
#        <iframe src="https://...">      -> frame-src
#        <script src="https://...">      -> script-src
#        <img src="https://...">         -> img-src
#        <link rel="stylesheet" ...>     -> style-src
#        loads data in the background    -> connect-src
#
# 2. Add just the domain (no path) to that directive on the
#    Content-Security-Policy line above, separated by a space.
#
# 3. Reload the page and press F12 -> Console. If something is still blocked,
#    the red message NAMES the address and the directive to add it to.
#
# COPY-PASTE EXAMPLES (replacements for the directive shown)
#
#   YouTube video (iframe):
#     frame-src 'self' https://snapwidget.com https://www.youtube-nocookie.com https://www.youtube.com
#
#   Google Maps (iframe):
#     frame-src 'self' https://snapwidget.com https://www.google.com
#
#   Booking widget, e.g. Calendly (script AND iframe - needs BOTH lines):
#     script-src 'self' https://snapwidget.com https://assets.calendly.com
#     frame-src 'self' https://snapwidget.com https://calendly.com
#
# Rule of thumb: a widget that is a <script> and also shows a panel almost
# always needs its domain in BOTH script-src and frame-src.
#
# Fuller write-up: ../SITE-OPTIMIZATION-NOTES.md
# ---------------------------------------------------------------------------
