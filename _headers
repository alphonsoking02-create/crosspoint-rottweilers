# Netlify cache + security headers — Crosspoint Rottweilers
#
# WHY THIS FILE EXISTS
# By default Netlify serves everything as "max-age=0, must-revalidate", so a
# returning visitor re-checks every single photo on every page view. These rules
# let the browser reuse what it already downloaded, which is most of the speed
# gain for anyone who visits more than one page.
#
# IMPORTANT — HOW TO CHANGE A PHOTO
# Photos are cached for a year BY FILENAME. If you edit or replace a photo, save
# it under a NEW filename (adidas-card.webp -> adidas-card-v2.webp) and update the
# page to point at it. If you re-upload over the same filename, people who have
# already visited may keep seeing the OLD picture for a long time.
#
# If you edit style.css, bump the ?v= number in the pages (currently ?v=8).

# Photos — safe to cache hard, they are versioned by filename.
/images/*
  Cache-Control: public, max-age=31536000

# Digital business card (/card/) assets. Listed individually rather than
# /card/* so the page's own HTML keeps revalidating.
/card/card-hero.webp
  Cache-Control: public, max-age=31536000
/card/crest.png
  Cache-Control: public, max-age=31536000
/card/crosspoint_available_puppies_qr.png
  Cache-Control: public, max-age=31536000

# Self-hosted fonts — never change, safe to cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000

# Favicons / app icons at the site root.
/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon-16x16.png
  Cache-Control: public, max-age=2592000
/favicon-32x32.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/android-chrome-192x192.png
  Cache-Control: public, max-age=2592000
/android-chrome-512x512.png
  Cache-Control: public, max-age=2592000

# CSS/JS are cache-busted with ?v=N in the pages. 30 days, so a forgotten bump
# corrects itself rather than sticking for a year.
/style.css
  Cache-Control: public, max-age=2592000
/script.js
  Cache-Control: public, max-age=2592000

# Security headers for everything.
#
# NOTE: do NOT put Cache-Control in this /* block. Netlify lets the catch-all
# override the specific rules above, which silently kills all image caching.
# Pages get Netlify's default (max-age=0, must-revalidate) anyway, which is
# exactly what we want for HTML.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
